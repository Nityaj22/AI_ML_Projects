{
  "expo": {
    "name": "REPLOCK",
    "slug": "replock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "replock",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "REPLOCK needs camera to verify your exercise form."
        }
      ],
      [
        "expo-notifications"
      ],
      [
        "expo-router"
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.replock.app",
      "infoPlist": {
        "NSCameraUsageDescription": "REPLOCK uses your camera to verify exercise form."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.replock.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
